{
  "name": "insurance-crm",
  "version": "1.0.1",
  "private": true,
  "description": "InsuraFlow CRM Enterprise - Insurance & Taxes Management",
  "main": "backend/server.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:backend": "node backend/test-server.cjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:seed": "node backend/db/seed.js",
    "db:reset": "npm run db:seed",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "test": "playwright test e2e/insuraflow.spec.ts",
    "test:headed": "playwright test e2e/insuraflow.spec.ts --headed",
    "test:debug": "playwright test e2e/insuraflow.spec.ts --debug",
    "test:report": "playwright show-report",
    "test:auth": "playwright test -g \"Suite 1: Authentication\"",
    "test:rbac": "playwright test -g \"Suite 3: RBAC\" || playwright test -g \"Suite 4: RBAC\"",
    "test:crud": "playwright test -g \"Suite 5: CRUD\"",
    "test:update-snapshots": "playwright test e2e/insuraflow.spec.ts --update-snapshots",
    "test:ci": "npm run build && npm run test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^8.5.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "speakeasy": "^2.0.0",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  }
}
