# ==========================================
# INSURAFLOW CRM - PRODUCTION ENVIRONMENT
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Database Configuration (SQLite for this deployment)
DATABASE_URL=sqlite:./insurance_crm.db
DB_BACKUP_INTERVAL=360  # Backup every 6 hours

# Security: JWT Configuration (CRITICAL - CHANGE IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security: Encryption key for sensitive fields (MUST CHANGE IN PRODUCTION - min 32 chars)
ENCRYPTION_KEY=your-encryption-key-min-32-chars-change-in-production

# Security: Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-change-in-production

# CORS - Whitelist origin for cross-origin requests
CORS_ORIGIN=https://insuraflow.yourapp.com,https://yourapp.com

# Email Configuration (SendGrid)
SENDGRID_API_KEY=sg_your_sendgrid_api_key
FROM_EMAIL=noreply@insuraflow.com
FROM_NAME=InsuraFlow CRM

# Frontend Configuration
VITE_API_URL=https://api.insuraflow.yourapp.com/api
APP_URL=https://insuraflow.yourapp.com

# Monitoring & Logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info

# Performance Monitoring
DATADOG_API_KEY=your_datadog_api_key
ENABLE_PERFORMANCE_MONITORING=true

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
STRICT_RATE_LIMIT_MAX=10

# Cache Configuration
CACHE_TTL_CLIENTS=300  # 5 minutes
CACHE_TTL_RENEWALS=600  # 10 minutes
CACHE_TTL_PROFILE=3600  # 1 hour

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production
SESSION_TIMEOUT=3600  # 1 hour

# API Timeout
API_REQUEST_TIMEOUT=10000  # 10 seconds

# ==========================================
# NOTES FOR DEPLOYMENT
# ==========================================
# 1. All SECRET and KEY values MUST be changed in production
# 2. Never commit .env file to version control
# 3. Use strong, random values for all secrets (min 32 chars)
# 4. Enable HTTPS in production (Strict-Transport-Security)
# 5. Configure proper CORS origins
# 6. Set up regular database backups
# 7. Monitor error rates with Sentry/DataDog
# 8. Enable audit logging for compliance
# 9. Rotate secrets periodically
# 10. Use environment-specific configuration
